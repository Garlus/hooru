# Copy this file to keystore.properties and fill in the local signing credentials.
# Never commit keystore.properties or the referenced .jks file.
# CI alternative: HOORU_RELEASE_STORE_FILE, HOORU_RELEASE_STORE_PASSWORD,
# HOORU_RELEASE_KEY_ALIAS and HOORU_RELEASE_KEY_PASSWORD.
storeFile=release-keystore.jks
storePassword=replace-with-a-strong-password
keyAlias=hooru
keyPassword=replace-with-a-strong-password
